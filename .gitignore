# 검출 결과 이미지 (실행 중 쌓임)
output/

# 로컬 preview 결과물
preview.png

# 가상환경
.venv/

# 파이썬 캐시
__pycache__/
*.py[cod]
.pytest_cache/

# 테스트 fixture 이미지는 커밋 유지 (통합 테스트에 필요)
!tests/fixtures/

# 딥러닝 비교 실험용 별도 venv (torch ~2GB) — 서비스 배포에는 불필요
.venv-dl/

# 검출 성능 측정용 샘플 이미지 (40장 84MB) — 리포에 넣기엔 무겁다.
# 정답 라벨 JSON(409KB)은 커밋 유지: config.py/docs 의 모든 실측 수치가
# 이 라벨 기준이라, 라벨이 없으면 그 값들을 재검증할 수 없다.
# `sample/` 로 쓰면 git이 디렉터리 안으로 내려가지 않아 아래 예외가 무시된다.
sample/**

# 에이전트 세션 로컬 상태
.omc/
